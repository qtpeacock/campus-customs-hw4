# Copy to .env (in HW4/ or the folder above it) and fill in locally. Never commit .env.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-5.6-luna
# Optional: a different model just for the shop chat
# CHAT_MODEL=gpt-5.6-luna
# Set to true when serving over HTTPS
# COOKIE_SECURE=false
# Optional: where links in cart reminder emails point (defaults to the Vite dev server)
# SITE_URL=http://127.0.0.1:5173
# Optional: require this token (X-Admin-Token header) for the staff outbox; without it, staff pages only work on this machine
# ADMIN_TOKEN=change-me
